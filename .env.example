# ---------------------------------------------------------------------------
# Kalshi self-learning worker - environment variables
# Copy to your Railway service variables. Everything has a safe default;
# trading is PAPER until you explicitly set LIVE_TRADING=1.
# ---------------------------------------------------------------------------

# --- Data source -----------------------------------------------------------
# "kalshi" for the live exchange, "sim" to replay the offline simulator
# (useful for a no-credentials smoke test of the whole loop on Railway).
DATA_SOURCE=kalshi
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# --- Kalshi credentials (required for live trading / private endpoints) ----
# Create an API key in the Kalshi dashboard; you get a key id + an RSA private
# key (PEM).  Provide the PEM either inline (KALSHI_PRIVATE_KEY, with real
# newlines) or, more conveniently for env vars, base64-encoded:
#   base64 -w0 kalshi_private_key.pem
KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
KALSHI_PRIVATE_KEY_B64=

# --- Persistence -----------------------------------------------------------
# Railway Postgres sets DATABASE_URL automatically when you attach the plugin.
# Locally it defaults to a SQLite file.
# DATABASE_URL=postgresql://user:pass@host:5432/db
# Mount a Railway Volume at /data so trained models survive redeploys.
MODEL_DIR=/data/models

# --- Trading mode (shadow -> promote) --------------------------------------
LIVE_TRADING=0          # 0 = paper (default). Set 1 to send REAL orders.
TRADING_ENABLED=1       # global kill-switch; 0 halts all order placement.
STARTING_BANKROLL=10000

# --- Risk caps (enforced before every live order) --------------------------
RISK_MAX_POSITION_DOLLARS=50
RISK_MAX_TOTAL_EXPOSURE=500
RISK_MAX_OPEN_POSITIONS=40
RISK_DAILY_LOSS_LIMIT=100
RISK_MAX_CONTRACTS_PER_ORDER=250

# --- Loop cadence ----------------------------------------------------------
CYCLE_SECONDS=300       # seconds between trading cycles
LEARN_EVERY_CYCLES=12   # retrain/promote a challenger every N cycles
MIN_LABELS_TO_TRAIN=800 # cold-start: collect this many outcomes before trading

# --- News / sentiment (optional) -------------------------------------------
# Any headlines API returning {"articles":[{"title":...,"description":...}]}
# (e.g. NewsAPI.org). Leave blank to disable; the loop runs fine without it.
NEWS_API_URL=
NEWS_API_KEY=

# --- Simulator knobs (only when DATA_SOURCE=sim) ---------------------------
SIM_SEED=0
SIM_MARKETS=8000
SIM_MARKETS_PER_CYCLE=200

# LOG_LEVEL=INFO
